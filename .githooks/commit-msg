#!/usr/bin/env bash
# Rejects commit messages that carry AI/tool attribution. Project rule: no "Co-Authored-By: Claude",
# no "Generated with ..." lines, no AI attribution of any kind in commits or PR text.
msg_file="$1"
if grep -qiE '^[[:space:]]*co-authored-by:.*(claude|anthropic|noreply@anthropic|copilot|chatgpt|openai|gemini|\bai\b)|generated (with|by).*(claude|ai\b|copilot|chatgpt)|🤖' "$msg_file"; then
  echo "commit-msg: AI/tool attribution found in the commit message. Remove it (project rule, see docs/AGENT_CODING_GUIDE.md section 1)." >&2
  exit 1
fi
exit 0
