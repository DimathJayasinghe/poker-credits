<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: no cloud backup and no device-to-device transfer. The session
     tokens are in the Android Keystore-backed store and the room journal belongs to a live game;
     a restored copy would only be stale or undecryptable. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
