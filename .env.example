# Environment Variables — Poker Credits

# Copy this file to .env and fill in values before running.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (cloud mode)
# Example: https://pokercredits.app,https://www.pokercredits.app
ALLOWED_ORIGINS=http://localhost:3001

# ── Networking Mode ──────────────────────────────────────────
# Set to "true" to bind server to 0.0.0.0 for LAN/offline play
LAN_MODE=false

# ── Crash Recovery Snapshots ─────────────────────────────────
# Directory for post-hand JSON snapshots (LAN mode)
SNAPSHOT_DIR=./snapshots

# Redis URL for snapshot storage (cloud mode, optional)
# Leave blank to use file-based snapshots
# REDIS_URL=redis://localhost:6379

# ── Room Settings ─────────────────────────────────────────────
# Minutes of inactivity before a room is garbage-collected
ROOM_TTL_MINUTES=60

# ── Security ──────────────────────────────────────────────────
# Secret used for signing host tokens (use a long random string in production)
HOST_TOKEN_SECRET=change-me-in-production

# ── Client (Next.js) ─────────────────────────────────────────
# Public WebSocket server URL (accessible from the browser)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
