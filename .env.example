# Environment variables for the standalone cloud server (`server/` binary).
# The embedded host-mode server inside the app does not read these; the app passes a config struct instead.
# Copy to .env. Never commit .env.

# Address and port to bind. 0.0.0.0 to accept remote connections.
POKER_BIND=0.0.0.0:7878

# Directory for room snapshots and action journals (mount a volume in Docker).
POKER_DATA_DIR=./data

# Comma-separated browser origins allowed to open a WebSocket. Empty = reject all browser origins
# (native apps send no Origin header). Needed only for the future web client.
# Example: https://play.pokercredits.app
POKER_ALLOWED_ORIGINS=

# Optional: directory with the built Flutter web player to serve at "/". Empty = do not serve.
POKER_WEB_DIR=

# Limits (defaults shown).
POKER_MAX_CONN_PER_IP=40
POKER_ROOM_TTL_MINUTES=60

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
